# LLM Provider (groq, openai, anthropic, vertex)
LLM__PROVIDER=gemini
LLM__MODEL=gemini-1.5-flash
LLM__TEMPERATURE=0.1
GEMINI_API_KEY=your_gemini_key_here

# Vision
VISION__PROVIDER=gemini
VISION__MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Embeddings
EMBED__MODEL=sentence-transformers/all-mpnet-base-v2
EMBED__DEVICE=cpu

# Vector Store (Qdrant)
VECTOR__PROVIDER=qdrant
VECTOR__QDRANT_HOST=localhost
VECTOR__QDRANT_PORT=6333
VECTOR__QDRANT_COLLECTION=fixguide_repair_chunks

# iFixit API (for corpus ingestion)
IFIXIT_API_KEY=your_ifixit_key_here

# Logging
LOG__LEVEL=INFO
LOG__FORMAT=json